# Copy to .env and adjust. Every value is optional — defaults shown.

# Laptop library (the phone mirrors this). Default: your Windows Music folder, e.g. /mnt/c/Users/<you>/Music
# MSYNC_LIBRARY=/mnt/c/Users/you/Music

# Where `msync backup` copies the phone's Music folder before a first-time reorganize
# MSYNC_BACKUP=/mnt/e/Music/PhoneBackup

# Music folder on the phone
# MSYNC_PHONE_MUSIC=/sdcard/Music

# adb executable. Default: adb.exe on PATH, else winget's Google.PlatformTools install
# MSYNC_ADB=/mnt/c/Users/you/AppData/Local/Microsoft/WinGet/Packages/.../platform-tools/adb.exe
